# Single-host prod-like profile example.
STATARB_PROFILE=single-host-prod-like
STATARB_LOG_LEVEL=INFO
STATARB_STRUCTURED_LOGS=true
STATARB_ARTIFACTS_DIR=var/single-host-prod-like
STATARB_EVENT_LOG_DIR=var/single-host-prod-like/events

ALOR_CONTOUR=test
ALOR_TEST_REFRESH_TOKEN=
ALOR_TEST_PORTFOLIO=

DATABASE_URL=postgresql://user:password@localhost:5432/statarb
STATARB_ENABLE_LIVE_TRADING=false
